# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma / sqlite
/prisma/dev.db
/prisma/dev.db-journal

# fotos de produtos enviadas pelo admin (conteúdo do usuário, não versionado)
/public/uploads/*
!/public/uploads/.gitkeep

# certificado digital A1 (.pfx/.p12) — NUNCA deve entrar no Git. Instalado
# manualmente no servidor durante o deploy — ver HANDOFF.md.
/certs/*
!/certs/README.md

# logs do PM2/nginx/scripts — gerados em runtime no servidor.
/logs/*
!/logs/.gitkeep

# backups do banco (scripts/backup.sh) — nunca devem ir pro Git (dados reais de clientes).
/backups/*
!/backups/.gitkeep

