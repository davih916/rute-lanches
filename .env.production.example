# =============================================================================
# Rute Lanches — variáveis de ambiente de produção
# Copie este arquivo para `.env` no servidor e preencha os valores reais.
# NUNCA commite o `.env` de verdade — ele já está no .gitignore.
# =============================================================================

# --- Banco de dados ---
# Postgres do docker-compose (serviço "postgres") ou um Postgres gerenciado
# (Neon, Vercel Postgres, RDS...). Formato: postgresql://usuario:senha@host:5432/banco
DATABASE_URL="postgresql://rutelanches:senha-forte-aqui@postgres:5432/rutelanches?sslmode=disable"

# Usados só pelo container postgres do docker-compose.yml (ignorados se você
# usar um Postgres gerenciado externo em vez do serviço "postgres" do compose).
POSTGRES_USER="rutelanches"
POSTGRES_PASSWORD="troque-por-uma-senha-forte"
POSTGRES_DB="rutelanches"

# --- Autenticação (sessão do admin e do portal do cliente) ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-uma-string-aleatoria-de-64-caracteres-hex"

# --- Criptografia de segredos no banco (client_secret/token do PagBank) ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FISCAL_ENCRYPTION_KEY="troque-por-uma-string-aleatoria-de-64-caracteres-hex"

# --- Seed inicial (só usado ao rodar prisma/seed.ts) ---
SEED_ADMIN_EMAIL="admin@rutelanches.com.br"
SEED_ADMIN_PASSWORD="troque-antes-do-primeiro-login-em-producao"

# --- Emissão fiscal (NFC-e) — ver HANDOFF.md §7/§7.1 ---
# "pending" = não emite notas | "nuvem_fiscal" = emissão real via Nuvem Fiscal.
FISCAL_PROVIDER="pending"
# "homologacao" (testes, sem valor fiscal) | "producao" (valor fiscal real).
FISCAL_AMBIENTE="homologacao"
NUVEM_FISCAL_CLIENT_ID=""
NUVEM_FISCAL_CLIENT_SECRET=""
# Caminho local do certificado A1 (.pfx/.p12), instalado manualmente no
# servidor (pasta certs/, fora do Git — ver certs/README.md).
FISCAL_CERTIFICADO_PATH="./certs/certificado.pfx"
FISCAL_CERTIFICADO_SENHA=""

# --- PagBank (Pix) ---
# IMPORTANTE: hoje estas credenciais são configuradas pelo painel admin
# (Configurações → PagBank) e ficam guardadas criptografadas no banco
# (tabela pagbank_config), NÃO lidas destas variáveis de ambiente. As linhas
# abaixo existem só como referência/documentação — preencher aqui não tem
# efeito até que o código seja alterado para lê-las (fora do escopo desta
# preparação de infraestrutura).
PAGBANK_CLIENT_ID=""
PAGBANK_CLIENT_SECRET=""
PAGBANK_TOKEN=""

# --- URL pública da aplicação ---
# Usada para montar a notification_url do webhook do PagBank. Defina com o
# domínio real de produção (com https://, sem barra no final).
APP_URL="https://seu-dominio.com.br"

# --- Ambiente ---
NODE_ENV="production"
PORT="3000"
