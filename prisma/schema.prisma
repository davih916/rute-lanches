generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Valores monetários são sempre armazenados em CENTAVOS (Int) para evitar
// problemas de arredondamento com ponto flutuante.
//
// Campos de "status" são String (não enum nativo) para manter portabilidade
// entre SQLite (dev) e Postgres/MySQL (produção). Os valores válidos são
// centralizados em `src/lib/constants.ts` e validados via Zod nas fronteiras
// da aplicação (API routes).
// ---------------------------------------------------------------------------

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("owner") // "owner" | "staff"
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  statusChanges OrderStatusHistory[]

  @@map("admins")
}

// Empresa assinante da plataforma. O acesso ao painel do cliente é mantido
// separado dos administradores da loja para não misturar permissões.
model Cliente {
  id                 String   @id @default(cuid())
  empresaNome        String
  razaoSocial        String
  cnpj               String   @unique
  regimeTributario   String
  inscricaoEstadual  String?
  inscricaoMunicipal String?
  email              String   @unique
  telefone           String?
  logradouro         String?
  numero             String?
  complemento        String?
  bairro             String?
  cidade             String?
  uf                 String?
  cep                String?
  codigoIbge         String?
  cnaePrincipal      String?
  cnaeDescricao      String?
  status             String   @default("ativo")
  plano              String   @default("Plano Essencial")
  statusAssinatura   String   @default("ativa")
  proximoVencimento  DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  usuarios ClienteUsuario[]

  @@map("clientes")
}

model ClienteUsuario {
  id                    String   @id @default(cuid())
  clienteId             String
  cliente               Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  email                 String   @unique
  passwordHash          String
  nome                  String
  ativo                 Boolean  @default(true)
  deveAlterarSenha      Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([clienteId])
  @@map("clientes_usuarios")
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  order     Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  name        String
  slug        String   @unique
  description String
  ingredients String
  priceCents  Int
  imageUrl    String?
  active      Boolean  @default(true)
  order       Int      @default(0)

  // Dados fiscais — obrigatórios para emitir NFC-e deste produto.
  ncm               String? // Nomenclatura Comum do Mercosul (8 dígitos)
  cfop              String? // Código Fiscal de Operações (ex: 5102)
  csosnCst          String? // CSOSN (Simples Nacional) ou CST (regime normal)
  unidadeComercial  String  @default("UN")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  addons     ProductAddon[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@map("products")
}

model ProductAddon {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  priceCents Int
  active     Boolean @default(true)

  orderItemAddons OrderItemAddon[]

  @@index([productId])
  @@map("product_addons")
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  address       String? // opcional: pedidos de retirada não precisam de endereço
  addressNumber String?
  neighborhood  String?
  complement    String?
  reference     String?
  cep           String? // dígitos, sem hífen — ver DeliveryZone.cepPrefix
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]

  @@map("customers")
}

// Área atendida pela entrega, identificada por PREFIXO DE CEP (não mais por
// nome de bairro digitado livremente — ver §6.3 do HANDOFF). `active=false`
// remove a zona do checkout sem apagar o histórico de pedidos que já a
// usaram (mesmo padrão de Category/Product — exclusão só é permitida se
// nenhum pedido referenciar a zona).
model DeliveryZone {
  id           String   @id @default(cuid())
  neighborhood String   @unique // nome de exibição (ex: "Jardim Aparecidinha"), não é mais a chave de busca
  // Prefixo dos dígitos do CEP (ex: "18095") — o pedido é encaixado na zona
  // com o prefixo mais longo/específico que bater com o CEP digitado (ver
  // findZoneForCep em delivery-zone-service.ts). Nullable só por causa de
  // zonas antigas (de antes desta mudança) que nunca tiveram CEP — a
  // validação da API exige o campo pra qualquer zona criada/editada agora.
  cepPrefix    String?  @unique
  feeCents     Int
  active       Boolean  @default(true)
  // Zonas reais (área de entrega) ficam visíveis no checkout do site. Zonas
  // criadas só pra registrar um endereço/cliente específico com taxa
  // combinada à parte (ex: "Casa da Dona Maria nº222") ficam com
  // visibleToCustomers=false — continuam disponíveis pro admin usar na Venda
  // no Balcão, mas não entram na busca por CEP do checkout público.
  visibleToCustomers Boolean @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]

  @@map("delivery_zones")
}

model Order {
  id               String    @id @default(cuid())
  orderNumber      Int       @unique
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id])
  status           String    @default("recebido")
  // "aguardando_pagamento" (só pedidos Pix — criado nesse status e fica FORA
  // do Kanban até o admin confirmar manualmente que o Pix caiu, ver
  // confirmPixPayment em order-service.ts) | "recebido" (novo pedido — para
  // entrega, também significa "aguardando confirmação da entrega" enquanto
  // não for aprovado/recusado, ver § approveDelivery/rejectDelivery em
  // order-service.ts) | "preparando" | "saiu_entrega" (só entrega) |
  // "pronto_retirada" (só retirada/balcão) | "entregue" | "cancelado"
  deliveryType     String    @default("entrega")
  // "entrega" | "retirada" | "balcao" (venda no balcão, criada pelo admin)
  paymentMethod    String
  // "pix" | "dinheiro" | "cartao_credito" | "cartao_debito"
  paymentStatus    String    @default("pendente")
  // "pendente" | "pago" | "erro" — independente do status de preparo acima.
  cashChangeForCents Int? // troco: valor com que o cliente vai pagar (só quando paymentMethod = "dinheiro")
  wantsInvoice     Boolean   @default(false) // cliente marcou "quero nota fiscal" no checkout
  itemsTotalCents  Int
  // Endereço de entrega: SNAPSHOT no momento do pedido. Guardado no Order
  // (não só no Customer) porque o cadastro do Customer é mutável e um
  // cliente pode pedir de endereços diferentes em pedidos diferentes;
  // sem esse snapshot, pedidos antigos mostrariam o endereço ATUAL do
  // cliente na hora de reimprimir a comanda, não o de quando pediu.
  address          String?
  addressNumber    String?
  // Nome do bairro da DeliveryZone encontrada pelo CEP no momento do pedido
  // (não é mais digitado livremente pelo cliente — ver §6.3 do HANDOFF).
  neighborhood     String?
  complement       String?
  reference        String?
  cep              String? // dígitos do CEP digitado no checkout, sem hífen
  // Zona (bairro/CEP) encontrada pelo CEP digitado no checkout — define
  // `deliveryFeeCents` automaticamente na criação do pedido (ver createOrder
  // em order-service.ts). RESTRICT: não deixa apagar uma zona já usada em
  // pedido (só desativar).
  deliveryZoneId   String?
  deliveryZone     DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: Restrict)
  // Preenchido automaticamente a partir da DeliveryZone encontrada pelo CEP —
  // a loja ainda confirma o pedido antes de liberar o Pix (ver
  // approveDelivery), podendo ajustar o valor numa exceção pontual dentro da
  // área (rua que não atende, etc), mas o ponto de partida já vem certo.
  deliveryFeeCents Int       @default(0)
  // true só quando a taxa foi confirmada de propósito (aprovação com valor >
  // 0, ou o botão dedicado "Definir taxa e enviar Pix" — mesmo que o valor
  // seja 0, ali é sempre intencional). Enquanto for false, o Pix NÃO é
  // liberado pro cliente (ver getOrCreatePixCharge em pagbank-service.ts) —
  // evita cobrar um valor errado quando o admin aprova a entrega sem
  // perceber que deixou a taxa em R$0,00.
  deliveryFeeConfirmed Boolean @default(false)
  totalCents       Int
  // Preenchido só quando a entrega é recusada pelo admin (rejectDelivery).
  rejectionReason  String?
  // JSON array de status ("preparando", "saiu_entrega", etc.) para os quais
  // já foi gerado/confirmado o aviso de WhatsApp pro cliente — evita que o
  // botão "Avisar cliente" seja clicado achando que ainda não avisou (ver
  // src/lib/order-notifications.ts). Envio em si é manual (link wa.me), não
  // uma API que garanta entrega — o registro é só de controle na tela.
  notifiedStatuses String    @default("[]")
  notes            String?
  printedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  fiscal        Fiscal?
  pixCharge     PixCharge?

  @@index([status])
  @@index([createdAt])
  @@index([customerId])
  @@index([deliveryZoneId])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  productName    String // snapshot do nome no momento da compra
  quantity       Int
  unitPriceCents Int    // snapshot do preço no momento da compra
  notes          String?

  addons OrderItemAddon[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderItemAddon {
  id          String        @id @default(cuid())
  orderItemId String
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addonId     String?
  addon       ProductAddon? @relation(fields: [addonId], references: [id])
  name        String // snapshot
  priceCents  Int    // snapshot

  @@index([orderItemId])
  @@map("order_item_addons")
}

model OrderStatusHistory {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String
  changedAt   DateTime @default(now())
  changedById String?
  changedBy   Admin?   @relation(fields: [changedById], references: [id])

  @@index([orderId])
  @@map("order_status_history")
}

// Linha única (id fixo "default") com as configurações da loja.
// Mantém o sistema replicável: tudo que muda entre clientes fica aqui,
// nunca hardcoded no código.
model Settings {
  id               String   @id @default("default")
  storeName        String   @default("Rute Lanches")
  logoUrl          String?
  primaryColor     String   @default("#F97316")
  secondaryColor   String   @default("#16A34A")
  whatsapp         String?
  address          String?
  storeOpen        Boolean  @default(true)
  openingHours     String   @default("{}") // JSON serializado por dia da semana
  acceptedPaymentMethods String @default("[\"pix\",\"dinheiro\",\"cartao_credito\",\"cartao_debito\"]") // JSON array de PaymentMethod
  // Chave Pix simples da loja (CPF/CNPJ/e-mail/telefone/aleatória) usada para
  // gerar o QR Code estático "copia e cola" (ver src/lib/pix-brcode.ts) — não
  // depende de conta/API do PagBank. Se vazia, o Pix fica indisponível.
  pixKey           String?
  // "cpf_cnpj" | "email" | "telefone" | "aleatoria" — define como pixKey é
  // formatada dentro do BR Code (ver normalizePixKey em src/lib/pix-brcode.ts).
  // Sem isso, uma chave digitada com espaço/traço (ex: telefone) vira uma
  // chave Pix inválida que o banco do cliente rejeita.
  pixKeyType       String   @default("telefone")
  pixCity          String   @default("SOROCABA") // cidade do recebedor exigida no payload do BR Code Pix (sem acentos, maiúsculas)
  // Mês (formato "YYYY-MM") em que a mensalidade de manutenção do sistema foi
  // confirmada como paga — controla o banner de cobrança no fim do mês (ver
  // src/app/admin/dev/page.tsx e §9.2 do HANDOFF). Não é visível/editável pela
  // dona da loja, só pelo painel /admin/dev (senha própria, separada do login
  // dela).
  mensalidadePagaEm String?
  // Liga/desliga o banner de cobrança de mensalidade sem depender do dia do
  // mês — controlado só pelo painel /admin/dev (não visível pra loja).
  mensalidadeReminderEnabled Boolean @default(true)
  // Valor da mensalidade e cobrança Pix atual (via MensalidadePagamentoConfig
  // — credenciais próprias do desenvolvedor, "totalmente separadas" da
  // Sharpify usada nos pedidos). Snapshot de UM mês por vez: quando o mês
  // muda, uma nova cobrança é gerada por cima (ver mensalidade-pix-service.ts).
  mensalidadeValorCents        Int     @default(0)
  mensalidadeChargeMonth       String? // "YYYY-MM" a que a cobrança abaixo pertence
  mensalidadeChargeExternalId  String?
  mensalidadeChargeQrCodeText  String?
  deliveryFeeCents Int      @default(0)
  minOrderCents    Int      @default(0)
  receiptWidth     String   @default("80mm") // "58mm" | "80mm"
  lastOrderNumber  Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@map("settings")
}

// Nota fiscal (NFC-e) de cada pedido. A linha é criada junto com o pedido,
// sempre como "aguardando_emissao" — a emissão real só acontece quando o
// admin aciona "Emitir NFC-e" (ver src/lib/services/fiscal-service.ts).
model Fiscal {
  id               String    @id @default(cuid())
  orderId          String    @unique
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerDocument String? // CPF/CNPJ opcional
  status           String    @default("aguardando_emissao")
  // "aguardando_emissao" | "emitindo" (reivindicado, evita emissão duplicada
  // concorrente — ver fiscal-service.ts) | "emitida" | "erro"
  provider         String? // "pending" | "nuvem_fiscal" | "focus_nfe" | "plug_notas"
  ambiente         String? // "homologacao" | "producao" — em qual ambiente foi emitida
  externalId       String? // id do documento no provider (para consultas futuras)
  numero           Int? // número da NFC-e
  serie            Int? // série da NFC-e
  chaveAcesso      String? // chave de acesso de 44 dígitos
  pdfUrl           String? // DANFCE
  xmlUrl           String?
  xmlContent       String? // XML completo, guardado aqui para não depender do provider indefinidamente
  errorMessage     String?
  issuedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("fiscal")
}

// Configuração fiscal da loja (singleton, id fixo "default"). Guarda os
// dados necessários para emitir NFC-e: cadastro da empresa, certificado
// digital A1 e credenciais da API do provider fiscal.
// Provider/ambiente/credenciais da API (Nuvem Fiscal) e o certificado A1 NÃO
// ficam mais aqui — vêm de variáveis de ambiente e de um arquivo local no
// servidor (ver src/lib/services/fiscal-certificate-service.ts e HANDOFF.md).
// Esta tabela guarda só os dados cadastrais da empresa emitente (usados para
// registrar a empresa no provider) e o status do certificado.
model FiscalConfig {
  id String @id @default("default")

  // Dados cadastrais da empresa emitente.
  cnpj               String?
  razaoSocial        String?
  nomeFantasia       String?
  inscricaoEstadual  String?
  inscricaoMunicipal String?
  regimeTributario   String? // "simples_nacional" | "normal" | "mei"
  email              String?
  telefone           String?

  // Atividade econômica principal (CNAE), exibida no cadastro fiscal.
  cnaePrincipal  String?
  cnaeDescricao  String?

  // Endereço da empresa (exigido pela SEFAZ no cadastro do emitente).
  logradouro     String?
  numero         String?
  complemento    String?
  bairro         String?
  municipioCodigo String? // código IBGE do município
  municipioNome  String?
  uf             String?
  cep            String?

  // Status do certificado A1. O arquivo/senha em si NUNCA é persistido aqui —
  // é enviado direto para o provider no momento do upload e descartado.
  empresaRegistradaEm  DateTime?
  certificadoEnviadoEm DateTime?
  certificadoValidoAte DateTime?

  updatedAt DateTime @updatedAt

  @@map("fiscal_config")
}

// Configuração da integração PagBank (singleton, id fixo "default"). Guarda as
// credenciais para gerar cobranças PIX — mesmo padrão do FiscalConfig acima.
model PagBankConfig {
  id                    String    @id @default("default")
  clientId              String?
  clientSecretEncrypted String?
  tokenEncrypted        String?
  ambiente              String    @default("sandbox") // "sandbox" | "producao"
  testadoEm             DateTime?
  updatedAt             DateTime  @updatedAt

  @@map("pagbank_config")
}

// Configuração da integração Sharpify (singleton, id fixo "default") — gera
// cobrança Pix real via gateway de pagamento deles, com confirmação
// automática (ao contrário da chave Pix simples — ver Settings.pixKey), e
// manda o link/código pro cliente via WhatsApp quando o admin aprova a
// entrega. Configurado só pelo painel /admin/dev (não é visível pra loja —
// "totalmente separado" dos pedidos normais e da mensalidade, a pedido do
// desenvolvedor). Mesmo padrão de criptografia do PagBankConfig acima.
model SharpifyConfig {
  id                    String    @id @default("default")
  clientId              String?
  clientSecretEncrypted String?
  testadoEm             DateTime?
  updatedAt             DateTime  @updatedAt

  @@map("sharpify_config")
}

// Credenciais Sharpify usadas SÓ pra cobrar a mensalidade do sistema da
// própria loja — conta/credencial do desenvolvedor, sem nenhuma relação com
// a SharpifyConfig acima (que é da loja, pros pedidos dela). "Totalmente
// separado", a pedido explícito do desenvolvedor. Configurado só em
// /admin/dev.
model MensalidadePagamentoConfig {
  id                    String    @id @default("default")
  clientId              String?
  clientSecretEncrypted String?
  updatedAt             DateTime  @updatedAt

  @@map("mensalidade_pagamento_config")
}

// Cobrança PIX de um pedido (1:1). Criada sob demanda quando o cliente acessa
// a tela de pagamento; atualizada pelo webhook do PagBank quando o pagamento
// é confirmado.
model PixCharge {
  id             String    @id @default(cuid())
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  externalId     String? // id da cobrança no provider (PagBank ou Sharpify)
  provider       String    @default("chave_simples") // "chave_simples" | "sharpify" | "pagbank" — define como consultar/confirmar o pagamento
  status         String    @default("aguardando_pagamento")
  // "aguardando_pagamento" | "pago" | "expirado" | "erro"
  qrCodeText     String? // código copia e cola
  qrCodeImageUrl String? // link/imagem do QR Code retornado pelo PagBank
  amountCents    Int
  errorMessage   String?
  paidAt         DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([externalId])
  @@map("pix_charges")
}
